@page "/maps"
@using System.Collections.Immutable
@using Client.Features.Shared.Components
@inject IServiceProvider Services
@inject NavigationManager Navigation

<OpenGraph 
    Title="Случайные панорамы"
    Description="На этой странице можно попасть на случайную панораму в выбранной области"/>

<h1>Панорамы</h1>
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6 col-12 mb-3">
            <div class="input-group mb-2">
                <span class="input-group-text bi bi-pin-map"></span>
                <input type="text" class="form-control" value="@Seed" @onchange="@(e => SetSeed((string)e.Value!))"/>
                <button class="btn btn-primary" @onclick="@(NewRandomSeed)">
                    <i class="bi bi-dice-@(GetSeed() % 6 + 1)"></i>
                </button>
                <a class="btn btn-info" target="_blank"
                   href="@(Services.GetRequiredService<IMapFramesProvider>().GetExternalStreetViewUri(GetPoint()))">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
            </div>
            <div class="img-thumbnail" style="height: 20rem">
                <iframe
                    src="@(Services.GetRequiredService<IMapFramesProvider>().GetStreetViewUri(GetPoint()))"
                    allowfullscreen
                    width="100%"
                    height="100%">
                </iframe>
            </div>
        </div>
        <div class="col-lg-6 col-12 mb-3">
            <div class="input-group mb-2">
                <span class="input-group-text bi bi-compass"></span>
                <select class="form-select" @onchange="@(e => SetArea(int.Parse((string)e.Value!)))">
                    @foreach (var area in Areas.Values)
                    {
                        <option selected="@(area == GetArea())" value="@area.Id">
                            @area.Name
                        </option>
                    }
                </select>
                <button class="btn btn-warning" title="WIP">
                    <i class="bi bi-pencil"></i>
                </button>
            </div>
            <div class="img-thumbnail" style="height: 20rem">
                <iframe src="@(Services.GetRequiredService<IMapFramesProvider>().GetAreaDisplayUri(GetArea().Area))"
                        allowfullscreen
                        width="100%"
                        height="100%">
                </iframe>
            </div>
        </div>
    </div>
</div>


@code {

    [SupplyParameterFromQuery] 
    public string? Seed { get; set; }
    [SupplyParameterFromQuery] 
    public int? Area { get; set; }

    private const int HexLength = sizeof(int) * 2;

    public NamedArea GetArea() => Areas[Area!.Value];
    public int GetSeed() => Seed is null ? 0 : BitConverter.ToInt32(Convert.FromHexString(Seed));
    public Point GetPoint() => GetArea().Area.GetRandomPoint(new Random(GetSeed()));

    private void NewRandomSeed() => SetSeed(Random.Shared.Next());

    private void SetSeed(int seed) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(
        nameof(Seed), Convert.ToHexString(BitConverter.GetBytes(seed))));

    private void SetSeed(string seed) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(
        nameof(Seed), seed.PadRight(HexLength, '0')));

    private void SetArea(int areaId) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(
        nameof(Area), areaId));
    
    protected override void OnParametersSet()
    {
        if (Seed is not { Length: HexLength } || Seed.All(char.IsAsciiHexDigit) is false)
        {
            NewRandomSeed();
        }

        if (Area is null || Areas.ContainsKey(Area.Value) is false)
        {
            SetArea(Areas.Keys.First());
        }
    }

    private static readonly IReadOnlyDictionary<int, NamedArea> Areas = new[]
    {
        new NamedArea(
            Id: 1,
            Name: "Москва",
            Area: new EllipsoidArea((37.625f, 55.75f), 0.75f, 0.4f)),

        new NamedArea(
            Id: 2,
            Name: "Москва+",
            Area: new EllipsoidArea((37.625f, 55.75f), 1.25f, 0.8f)),

        new NamedArea(
            Id: 3,
            Name: "Челябинск",
            Area: new EllipsoidArea((61.402603f, 55.160133f), 0.25f, 0.2f))
        
    }.ToImmutableSortedDictionary(x => x.Id, x => x);

}